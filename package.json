{
  "name": "alts-academy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first, gamified self-study app for investment fundamentals and alternatives-industry knowledge.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:check": "tsx scripts/validate-content.ts",
    "content:build": "tsx scripts/build-manifest.ts",
    "verify": "npm run content:check && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "katex": "0.18.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
